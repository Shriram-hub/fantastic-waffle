# Node.js 24 or newer. No credentials are required for the sample workspace.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Required when HOST is not a loopback address. Use HTTPS behind a reverse proxy.
WORKSPACE_PASSWORD=
# Optional API adapters. Secrets stay on the server.
APOLLO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# A second switch is required before any real email can be sent.
ENABLE_LIVE_SEND=false
# Optional job board slugs, comma separated. Also editable in the interface.
GREENHOUSE_BOARDS=
LEVER_BOARDS=
