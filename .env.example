# Node.js 24 or newer. No credentials are required for the sample workspace.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Required when HOST is not a loopback address. Use HTTPS behind a reverse proxy.
WORKSPACE_PASSWORD=
# Optional API adapters. Secrets stay on the server.
APOLLO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# A second switch is required before any real email can be sent.
ENABLE_LIVE_SEND=false
# Optional job board slugs, comma separated. Also editable in the interface.
GREENHOUSE_BOARDS=
LEVER_BOARDS=

# Public origin for OAuth callbacks, push webhooks, and résumé share links.
PUBLIC_BASE_URL=http://127.0.0.1:3000
# Optional Redis dispatch. Without this, the separate worker uses the durable SQLite queue.
REDIS_URL=
ASHBY_BOARDS=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
HUNTER_API_KEY=
# Optional reserved contact API attempts per day, 1–100. Empty uses the UI policy.
CONTACT_API_DAILY_LIMIT=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Reused for Google sign-in (openid/email/profile) and separate Gmail consent.
# Unlock once with WORKSPACE_PASSWORD, then click Link Google sign-in.
# Both flows reuse PUBLIC_BASE_URL/api/oauth/google/callback.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# Gemini native API; all requests go directly to Google.
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Save your Google AI Studio key as LLM_API_KEY, not in frontend code.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Optional Gemini semantic matching: gemini-embedding-001
EMBEDDING_MODEL=
# Optional S3 or Cloudflare R2. Files stay private; application routes enforce access.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# PostgreSQL runtime. Leave blank for local SQLite. Use a shared/session pooler on IPv4 hosts.
DATABASE_URL=
# Optional PEM CA for other private-CA databases. Supabase uses the bundled public CA.
DATABASE_SSL_CA=

# Embedded runs a supervised child process alongside the API, sharing the database.
# Embedded worker starts with the web service by default. Set false only with a separate worker.
ENABLE_EMBEDDED_WORKER=true
# Legacy RUN_EMBEDDED_WORKER is still supported when ENABLE_EMBEDDED_WORKER is unset.
# Set false after applying server/db/runtime.sql through a database admin.
DATABASE_AUTO_MIGRATE=true

# Optional public job-feed key / credentialed ATS search.
HIMALAYAS_API_KEY=
SERPAPI_API_KEY=
# Optional web/people search fallback (JSearch supplies jobs, not people).
BRAVE_SEARCH_API_KEY=
FREE_CONTACT_WEB_SEARCH=true
# Signed cloud dispatcher. Store the same secret in Supabase Vault.
AUTOPILOT_CRON_SECRET=

# Independent automatic job search. Public feeds and 110 ATS boards need no keys.
# Keep enabled on a fresh hosted workspace to populate the Explore feed.
DISCOVERY_BOOTSTRAP=true
ENABLE_JOB_DISCOVERY=true
# Optional metered Google Jobs aggregation; enable its source in the interface.
JSEARCH_API_KEY=
JOB_SEARCH_API_DAILY_LIMIT=6
# Public recruiting-page contacts remain unverified until independently checked.
# Render Free blocks SMTP ports; there is no unlimited free mailbox verifier.

# Regional indexed job discovery and alumni X-ray reuse SERPAPI_API_KEY above.
# PDF generation and role-based interview kits require no extra provider key.
# Optional phone alerts: configure encrypted destination credentials in Connections.
# WhatsApp Cloud API only: override if your approved setup uses another Graph version.
WHATSAPP_GRAPH_VERSION=v23.0
